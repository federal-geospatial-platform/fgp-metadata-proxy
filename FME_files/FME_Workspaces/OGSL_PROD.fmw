ash>s+<quote><comma><space>given.strip<openparen><closeparen><closeparen><space>if<space>p<closebracket><lf><space><space><space><space>out_parts<space>=<space><openbracket><closebracket><lf><lf><space><space><space><space>for<space>part<space>in<space>parts:<lf><space><space><space><space><space><space><space><space>subparts<space>=<space><openbracket>sp<space>for<space>sp<space>in<space>part.split<openparen><quote>-<quote><closeparen><space>if<space>sp<closebracket><lf><space><space><space><space><space><space><space><space>sub_initials<space>=<space><openbracket><closebracket><lf><lf><space><space><space><space><space><space><space><space>for<space>sp<space>in<space>subparts:<lf><space><space><space><space><space><space><space><space><space><space><space><space>ini<space>=<space>_initial_from_token<openparen>sp<closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space>if<space>ini:<lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>sub_initials.append<openparen>f<quote><opencurly>ini<closecurly>.<quote><closeparen><lf><lf><space><space><space><space><space><space><space><space>if<space>sub_initials:<lf><space><space><space><space><space><space><space><space><space><space><space><space>out_parts.append<openparen><quote>-<quote>.join<openparen>sub_initials<closeparen><closeparen><lf><lf><space><space><space><space>return<space><quote><space><quote>.join<openparen>out_parts<closeparen><lf><lf><lf>#<space>----------------------------------------------------------------------<lf>#<space>Conjoining<space>helpers<space><openparen>ENGLISH<closeparen><lf>#<space>----------------------------------------------------------------------<lf><lf>def<space>_conjoin_apa_people<openparen>items<closeparen>:<lf><space><space><space><space><quote><quote><quote><lf><space><space><space><space>APA<space>7<space>reference<space>list<space>rules<space>for<space>people<space>or<space>mixed<space>authors.<lf><lf><space><space><space><space><space><space>-<space>1<space>author:<space><quote>A<quote><lf><space><space><space><space><space><space>-<space>2<space>authors:<space><quote>A<comma><space><amp><space>B<quote><lf><space><space><space><space><space><space>-<space>3<u2013>20<space>authors:<space><quote>A<comma><space>B<comma><space>C<comma><space><amp><space>D<quote><lf><space><space><space><space><space><space>-<space>21+<space>authors:<space>first<space>19<comma><space>...<comma><space>last<lf><space><space><space><space><quote><quote><quote><lf><space><space><space><space>n<space>=<space>len<openparen>items<closeparen><lf><lf><space><space><space><space>if<space>n<space>==<space>0:<lf><space><space><space><space><space><space><space><space>return<space><quote><quote><lf><space><space><space><space>if<space>n<space>==<space>1:<lf><space><space><space><space><space><space><space><space>return<space>items<openbracket>0<closebracket><lf><space><space><space><space>if<space>n<space><lt>=<space>20:<lf><space><space><space><space><space><space><space><space>return<space><quote><comma><space><quote>.join<openparen>items<openbracket>:-1<closebracket><closeparen><space>+<space>f<quote><comma><space><amp><space><opencurly>items<openbracket>-1<closebracket><closecurly><quote><lf><lf><space><space><space><space>return<space><quote><comma><space><quote>.join<openparen>items<openbracket>:19<closebracket><closeparen><space>+<space><quote><comma><space>...<comma><space><quote><space>+<space>items<openbracket>-1<closebracket><lf><lf><lf>def<space>_conjoin_organisations<openparen>items<closeparen>:<lf><space><space><space><space><quote><quote><quote><lf><space><space><space><space>Organisation-only<space>author<space>lists<space><openparen>NO<space>comma<space>before<space><amp><closeparen>:<lf><lf><space><space><space><space><space><space>-<space><quote>Org<space>A<quote><lf><space><space><space><space><space><space>-<space><quote>Org<space>A<space><amp><space